# Example nginx server block for puck.misaki.fi.
#
# Start HTTP-only (port 80) so certbot can complete the ACME challenge; then run
#   sudo certbot --nginx -d puck.misaki.fi
# and certbot ADDS the `listen 443 ssl` block + the HTTP->HTTPS redirect for you.
# Do NOT hand-write the 443 block.
#
# A single subdomain — no www variant, so one name on the cert is the whole
# story (unlike the apex-domain siblings).
#
# `root` points at the web root ITSELF — deploy.sh builds straight into it
# (--cleanDestinationDir), there is no `public/` subdir. Keep this in step with
# WEBROOT in deploy.sh (default /var/www/puck).

server {
    listen 80;
    listen [::]:80;
    server_name puck.misaki.fi;

    root /var/www/puck;
    index index.html;

    # Hugo builds 404.html at the web root.
    error_page 404 /404.html;

    # Apple App Site Association: no extension, served as JSON, NO redirect.
    # Exact-match so it wins over the dotfile deny and the try_files catch-all.
    # The app has no Universal Links today — this is here so that adding them
    # later is dropping a file into .well-known, not editing the server block.
    location = /.well-known/apple-app-site-association {
        default_type application/json;
    }

    # Hugo emits clean directory URLs (/support/ -> /support/index.html).
    location / {
        try_files $uri $uri/ =404;
    }

    # Fingerprinted CSS: filename changes on content change, so cache hard.
    location /css/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Don't serve dotfiles — except the .well-known dir (matched exactly above).
    location ~ /\.(?!well-known) {
        deny all;
    }
}
